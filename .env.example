PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=rotina_diabetica
DATABASE_USER=
DATABASE_PASSWORD=

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=1d

# Limites persistentes, por janela fixa (segundos). Inteiros positivos.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_FORGOT_IP_LIMIT=10
AUTH_FORGOT_ACCOUNT_LIMIT=3
AUTH_RESET_IP_LIMIT=20

# Validade do token de recuperação de senha, em minutos (padrão 30)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# disabled apenas em desenvolvimento/testes; produção exige smtp.
PASSWORD_RESET_MAIL_MODE=disabled
# Link da rota pública. Use HTTPS para web ou o scheme do development build.
PASSWORD_RESET_URL=glicaremobile://reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Origens permitidas, separadas por vírgula. Vazio = qualquer origem (só em desenvolvimento).
CORS_ORIGIN=
