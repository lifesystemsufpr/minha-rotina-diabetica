PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=rotina_diabetica
DATABASE_USER=
DATABASE_PASSWORD=

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=1d

# Validade do token de recuperação de senha, em minutos (padrão 30)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Origens permitidas, separadas por vírgula. Vazio = qualquer origem (só em desenvolvimento).
CORS_ORIGIN=

# Inclui o nome do usuário no PDF de relatórios (só após aprovação). Padrão: false
REPORT_PDF_INCLUDE_USER_NAME=false